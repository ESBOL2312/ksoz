{
  "name": "@ksoz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts serve",
    "start": "node dist/main.js serve",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/main.ts migrate",
    "db:seed": "tsx src/main.ts seed"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@ksoz/shared": "*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.0.0",
    "grammy": "^1.38.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.0.0",
    "pino": "^10.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0"
  }
}
