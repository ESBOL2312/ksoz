# Скопируйте в .env. Для docker compose значения по умолчанию уже подставлены.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ksoz
# Отдельная БД для интеграционных тестов (порт 5433 — контейнер ksoz-pg-test)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/ksoz_test

BOT_TOKEN=000000:dev-placeholder-token
BOT_USERNAME=ksoz_bot
WEBAPP_SHORT_NAME=app
WEBHOOK_SECRET=dev-webhook-secret

# Домен миниаппа (CORS); в development разрешено всё
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:3000
MINIAPP_URL=http://localhost:5173
# Telegram id админов через запятую
ADMIN_IDS=
